# MSSQL_TWNTAXIAD_DRIVER="ODBC Driver 18 for SQL Server"
# MSSQL_TWNTAXIAD_PORT=1433
# MSSQL_TWNTAXIAD_TRUST_SERVER_CERTIFICATE=yes

