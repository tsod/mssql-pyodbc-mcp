MSSQL_SERVER=192.168.0.215
MSSQL_DATABASE=244global
MSSQL_USER=sa
MSSQL_PASSWORD=change-me
MSSQL_DRIVER="ODBC Driver 18 for SQL Server"
MSSQL_PORT=1433
MSSQL_TRUST_SERVER_CERTIFICATE=yes

# Optional second DB. Tools can select it with db="<MSSQL_SECONDARY_DATABASE value>".
# db="secondary" is still accepted for backward compatibility.
# MSSQL_SECONDARY_SERVER=192.168.0.216
# MSSQL_SECONDARY_DATABASE=anotherdb
# MSSQL_SECONDARY_USER=sa
# MSSQL_SECONDARY_PASSWORD=change-me
# MSSQL_SECONDARY_DRIVER="ODBC Driver 18 for SQL Server"
# MSSQL_SECONDARY_PORT=1433
# MSSQL_SECONDARY_TRUST_SERVER_CERTIFICATE=yes

# Optional named DB: Tend. Tools can select it with db="Tend".
# MSSQL_TEND_SERVER=192.168.0.217
# MSSQL_TEND_DATABASE=Tend
# MSSQL_TEND_USER=sa
# MSSQL_TEND_PASSWORD=change-me
# MSSQL_TEND_DRIVER="ODBC Driver 18 for SQL Server"
# MSSQL_TEND_PORT=1433
# MSSQL_TEND_TRUST_SERVER_CERTIFICATE=yes

# Optional named DB: ProjectWorkTracker. Tools can select it with db="ProjectWorkTracker".
# MSSQL_PROJECTWORKTRACKER_SERVER=192.168.0.218
# MSSQL_PROJECTWORKTRACKER_DATABASE=ProjectWorkTracker
# MSSQL_PROJECTWORKTRACKER_USER=sa
# MSSQL_PROJECTWORKTRACKER_PASSWORD=change-me
# MSSQL_PROJECTWORKTRACKER_DRIVER="ODBC Driver 18 for SQL Server"
# MSSQL_PROJECTWORKTRACKER_PORT=1433
# MSSQL_PROJECTWORKTRACKER_TRUST_SERVER_CERTIFICATE=yes

# Optional named DB: TWNTaxiAD. Tools can select it with db="TWNTaxiAD".
